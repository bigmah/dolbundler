+// Dolphin truncates the parsed 32-bit value to the patch width and stores it
+// big-endian; see PatchEngine::ApplyPatches.
+void WriteBE(std::uint8_t* data, std::uint32_t value, unsigned width)
+{
+  for (unsigned index = 0; index < width; ++index)
+    data[index] = static_cast<std::uint8_t>(value >> ((width - 1 - index) * 8));
+}
+
+std::uint32_t ReadBE(const std::uint8_t* data, unsigned width)
+{
+  std::uint32_t value = 0;
+  for (unsigned index = 0; index < width; ++index)
+    value = (value << 8) | data[index];
+  return value;
+}
