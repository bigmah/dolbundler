#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# RecompGC - turn a GameCube/Wii disc image into a native macOS app.
#
#   1. extract the disc with Dolphin's DiscIO (ModernGekko --extract)
#   2. statically recompile its DOL (moderngekko-port build) to native arm64
#   3. emit a double-clickable .app that runs the result
#
# Usage: recompgc [--porcelain] [--app] [--no-open] [--backend c|llvm]
#                 <disc-image> [more images...]
#        recompgc play     --disc-id <id> --game-root <dir> --module <lib> --title <s>
#                          [--graphics <backend>] [--audio <backend>]
#        recompgc make-app --disc-id <id> --game-root <dir> --module <lib> --title <s>
#                          [--platform <s>] [--graphics <backend>] [--audio <backend>]
#        recompgc list-controllers
#        recompgc driver [--ensure|--stop|--status] [--pipe <name>]
#
# By default a disc is extracted, recompiled, and added to the library; it is
# played from DolBundler's list. --app additionally builds a .app in
# ~/Applications. `play` and `make-app` are what the window calls for an
# already-recompiled game.
#
# --backend picks how the DOL is recompiled. Both produce native arm64 and take
# a few minutes per game. `c` is the default and the reference: PowerPC to C to
# native, through the host compiler. `llvm` goes straight from DolIR to Mach-O
# objects in process, which is the path an iOS build uses - a module is linked
# into the app before it is signed, because iOS will not map a page executable
# without a valid signature behind it.
#
# --graphics and --audio override the defaults from toolchain.conf for one
# launch; the window passes whatever the game's settings resolved to. Everything
# else the runtime is configured with - internal resolution, fullscreen, the
# controller ports - lives in the ModernGekko config.ini the window writes
# before it starts a game.
#
# `list-controllers` prints the controllers the runtime can see, one per line,
# as "<device><TAB><label>". The first field is what a controller port has to be
# set to. Two kinds show up: SDL gamepads, and Dolphin "Pipe" devices - a FIFO
# in <user-dir>/Pipes that an external driver writes controller state into.
#
# `driver` manages one such driver, gc_controller, which is what makes a Nintendo
# Switch Online GameCube controller usable: the pad needs a proprietary
# handshake before it streams anything, so SDL enumerates it and then sees
# nothing. Its checkout is found by build.sh and recorded as GC_CONTROLLER in
# toolchain.conf; with none, everything here degrades to "no pipe devices".
#
# --porcelain adds machine-readable event lines for the GUI and drops the
# colour codes. Everything else on stdout is log text. The events are:
#
#   @@step <index> <total> <title>
#   @@info <key>=<value>        key in: image game_root disc_id name platform
#                                       module app
#   @@ok
#   @@fail <message>
set -uo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
CONF="$SELF_DIR/toolchain.conf"

MODE=pipeline
case "${1-}" in
  play|make-app|list-controllers|driver) MODE="$1"; shift ;;
esac

PORCELAIN=0
AUTO_OPEN=1
MAKE_APP=0
IMAGES=()
# Subcommand fields, unused by the pipeline.
ARG_DISC_ID=''; ARG_GAME_ROOT=''; ARG_MODULE=''; ARG_TITLE=''; ARG_PLATFORM=''
ARG_GRAPHICS=''; ARG_AUDIO=''
ARG_BACKEND=c
DRIVER_ACTION=status; ARG_PIPE=''
while [ "$#" -gt 0 ]; do
  case "$1" in
    --porcelain) PORCELAIN=1; AUTO_OPEN=0 ;;
    --app)       MAKE_APP=1 ;;
    --no-open)   AUTO_OPEN=0 ;;
    --open)      AUTO_OPEN=1 ;;
    --disc-id)   ARG_DISC_ID="${2-}"; shift ;;
    --game-root) ARG_GAME_ROOT="${2-}"; shift ;;
    --module)    ARG_MODULE="${2-}"; shift ;;
    --title)     ARG_TITLE="${2-}"; shift ;;
    --platform)  ARG_PLATFORM="${2-}"; shift ;;
    --graphics)  ARG_GRAPHICS="${2-}"; shift ;;
    --audio)     ARG_AUDIO="${2-}"; shift ;;
    --backend)   ARG_BACKEND="${2-}"; shift ;;
    --pipe)      ARG_PIPE="${2-}"; shift ;;
    --ensure)    DRIVER_ACTION=ensure ;;
    --stop)      DRIVER_ACTION=stop ;;
    --status)    DRIVER_ACTION=status ;;
    -*)          echo "unknown option: $1" >&2; exit 2 ;;
    *)           IMAGES+=("$1") ;;
  esac
  shift
done

if [ "$PORCELAIN" -eq 1 ]; then
  bold=''; dim=''; red=''; green=''; off=''
else
  bold=$'\033[1m'; dim=$'\033[2m'; red=$'\033[31m'; green=$'\033[32m'; off=$'\033[0m'
fi

emit()  { [ "$PORCELAIN" -eq 1 ] && printf '@@%s\n' "$*"; return 0; }
# In porcelain mode the GUI renders its own heading from the event, so the
# human-readable copy would show up twice.
step()  { emit "step $1 $2 $3"
          [ "$PORCELAIN" -eq 1 ] && return 0
          printf '\n%s==> %s/%s  %s%s\n' "$bold" "$1" "$2" "$3" "$off"; }
info()  { emit "info $1=$2"; }
note()  { printf '%s    %s%s\n' "$dim" "$*" "$off"; }
ok()    { printf '%s    %s%s\n' "$green" "$*" "$off"; }
die()   { emit "fail $*"; printf '\n%serror: %s%s\n' "$red" "$*" "$off" >&2; exit 1; }

case "$ARG_BACKEND" in
  c|llvm) ;;
  *) echo "unknown backend: $ARG_BACKEND (expected c or llvm)" >&2; exit 2 ;;
esac

[ -f "$CONF" ] || die "missing $CONF; re-run DolBundler/build.sh"
# shellcheck source=/dev/null
source "$CONF"

# A window launched from Finder inherits launchd's PATH - /usr/bin:/bin and the
# two sbins - so Homebrew's cmake and ninja are invisible exactly when the app
# is how you started this, and only then. build.sh records where it found them.
[ -n "${TOOLCHAIN_PATH-}" ] && export PATH="$TOOLCHAIN_PATH:$PATH"

: "${MG_BUILD:?toolchain.conf did not set MG_BUILD}"
: "${APPS_DIR:=$HOME/Applications}"
: "${GRAPHICS_BACKEND:=Metal}"
# A per-game choice from the window wins over the build-wide default.
[ -n "$ARG_GRAPHICS" ] && GRAPHICS_BACKEND="$ARG_GRAPHICS"
AUDIO_BACKEND="$ARG_AUDIO"
USER_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/moderngekko"
SUPPORT_DIR="$HOME/Library/Application Support/DolBundler"
LIBRARY="$SUPPORT_DIR/library.json"
COVERS="$SUPPORT_DIR/covers"

for tool in ModernGekko moderngekko-port moderngekko-run dolrecomp; do
  [ -x "$MG_BUILD/$tool" ] || die "$MG_BUILD/$tool is missing; re-run DolBundler/build.sh"
done

# --- Dolphin pipe devices ----------------------------------------------------
# Dolphin scans <user-dir>/Pipes once at startup and offers every FIFO there as
# an input device called Pipe/0/<filename>, fed by whatever writes to it. That
# is how a controller SDL cannot drive - the NSO GameCube pad - reaches a game.

: "${GC_CONTROLLER:=}"
PIPE_DIR="$USER_DIR/Pipes"
DRIVER_BIN="${GC_CONTROLLER:+$GC_CONTROLLER/target/release/gc_controller}"
DRIVER_PID_FILE="$USER_DIR/gc_controller.pid"
DRIVER_PIPE_FILE="$USER_DIR/gc_controller.pipe"
DRIVER_LOG="$USER_DIR/Logs/gc_controller.log"
DEFAULT_PIPE=gcc1

# The instance we started, if it is still alive. Deliberately narrow: a driver
# the user started themselves is never something this script stops.
driver_pid() {
  local pid comm
  pid="$(cat "$DRIVER_PID_FILE" 2>/dev/null)" || return 1
  [ -n "$pid" ] || return 1
  # Guard against the PID having been recycled by something else entirely.
  comm="$(ps -o comm= -p "$pid" 2>/dev/null)" || return 1
  [ -n "$comm" ] && [ "$(basename "$comm")" = gc_controller ] || return 1
  printf '%s' "$pid"
}

driver_start() {
  local name="$1"
  [ -n "$DRIVER_BIN" ] || die "the GameCube controller driver did not build when DolBundler was built; re-run DolBundler/build.sh and read what it says under \"Building the GameCube controller driver\""
  [ -x "$DRIVER_BIN" ] || die "$DRIVER_BIN is missing; build it with: cargo build --release --manifest-path $GC_CONTROLLER/Cargo.toml"
  mkdir -p "$PIPE_DIR" "$USER_DIR/Logs"

  # Someone else's instance owns the controller, and only one process can. If
  # its pipe landed here anyway there is nothing to do; if not, say so rather
  # than starting a second one that cannot claim the device.
  if pgrep -x gc_controller >/dev/null 2>&1; then
    # A FIFO left behind by a driver that has since exited outlives it, so its
    # existence proves nothing; ask whether that driver is pointed at this name.
    if [ -p "$PIPE_DIR/$name" ] && pgrep -f -- "--pipe-name $name" >/dev/null 2>&1; then
      note "using the gc_controller already running"
      return 0
    fi
    die "gc_controller is already running, but its pipe is not in $PIPE_DIR. Stop it ($GC_CONTROLLER/stop.sh) and let DolBundler start it, or run it with --pipe-dir $PIPE_DIR"
  fi

  note "starting gc_controller"
  # --reconnect so pulling the cable moves to Bluetooth instead of ending the
  # session. nohup because recompgc exits well before the game does.
  nohup "$DRIVER_BIN" --pipe-dir "$PIPE_DIR" --pipe-name "$name" --reconnect \
    >>"$DRIVER_LOG" 2>&1 &
  echo $! > "$DRIVER_PID_FILE"
  # Which FIFO it was pointed at. A driver feeds exactly one, and the next game
  # to want a pipe device may want a different one; see driver_ensure.
  printf '%s' "$name" > "$DRIVER_PIPE_FILE"

  # The FIFO is only created once the controller answers, so waiting for it is
  # waiting for the controller. 15s covers a Bluetooth scan.
  local waited=0
  while [ "$waited" -lt 150 ]; do
    [ -p "$PIPE_DIR/$name" ] && { ok "pipe ready: $PIPE_DIR/$name"; return 0; }
    driver_pid >/dev/null || break
    sleep 0.1
    waited=$((waited + 1))
  done

  driver_stop >/dev/null 2>&1
  printf '%s' "$dim"; tail -4 "$DRIVER_LOG" 2>/dev/null | sed 's/^/    /'; printf '%s' "$off"
  die "no GameCube controller answered. Plug it in over USB, or hold sync to pair over Bluetooth, then try again"
}

driver_stop() {
  local pid
  # A pid file left behind by a driver that exited on its own is stale, not a
  # process to signal, so clear it either way.
  pid="$(driver_pid)" || {
    rm -f "$DRIVER_PID_FILE" "$DRIVER_PIPE_FILE"
    note "no gc_controller of ours is running"
    return 0
  }
  kill -INT "$pid" 2>/dev/null || true
  local waited=0
  while [ "$waited" -lt 20 ] && kill -0 "$pid" 2>/dev/null; do
    sleep 0.1
    waited=$((waited + 1))
  done
  kill -0 "$pid" 2>/dev/null && kill -TERM "$pid" 2>/dev/null
  rm -f "$DRIVER_PID_FILE" "$DRIVER_PIPE_FILE"
  ok "gc_controller stopped"
}

# Makes sure something is feeding the pipe a port has been set to. "A driver is
# running" is not that question: a driver feeds exactly one FIFO, so one started
# for gcc1 leaves a game bound to pad1 reading a pipe with no writer. That is
# silent -- the FIFO exists, Dolphin opens it, the game starts, and no button
# ever arrives -- so it is worth the restart to get it right.
driver_ensure() {
  local name="$1" pid current
  if pid="$(driver_pid)"; then
    current="$(cat "$DRIVER_PIPE_FILE" 2>/dev/null)" || current=''
    # A driver started by a build that predates that file still says on its own
    # command line which FIFO it was pointed at.
    [ -n "$current" ] || current="$(ps -p "$pid" -o command= 2>/dev/null \
      | sed -n 's/.*--pipe-name \([^ ][^ ]*\).*/\1/p')"
    if [ -z "$current" ] || [ "$current" = "$name" ]; then
      note "gc_controller is already running"
      return 0
    fi
    note "gc_controller is feeding $current, but this port reads $name; restarting it"
    driver_stop >/dev/null 2>&1
  fi
  driver_start "$name"
}

# Every distinct pipe device the written config.ini assigns to a port. This is
# what makes `play` self-contained: the window has already recorded the choice,
# so nothing extra has to be passed down here.
configured_pipes() {
  sed -n 's|^controller[1-4]=Pipe/0/||p' "$USER_DIR/config.ini" 2>/dev/null | sort -u
}

if [ "$MODE" = list-controllers ]; then
  # SDL first. A build predating the --list-controllers patch prints its usage
  # to stderr and exits 2; an empty list and a failure are the same thing to the
  # caller, which is "no gamepads to offer".
  "$MG_BUILD/moderngekko-run" --list-controllers 2>/dev/null || true

  # Then the pipes, which Dolphin names after the file.
  for fifo in "$PIPE_DIR"/*; do
    [ -p "$fifo" ] || continue
    name="$(basename "$fifo")"
    printf 'Pipe/0/%s\t%s (pipe)\n' "$name" "$name"
  done

  # A driver that is installed but has never run has no FIFO yet, so offer it
  # anyway: choosing it is what tells `play` to start the driver.
  if [ -n "$DRIVER_BIN" ] && [ ! -p "$PIPE_DIR/$DEFAULT_PIPE" ]; then
    printf 'Pipe/0/%s\tGameCube controller (gc_controller)\n' "$DEFAULT_PIPE"
  fi
  exit 0
fi

if [ "$MODE" = driver ]; then
  pipe="${ARG_PIPE:-$DEFAULT_PIPE}"
  case "$DRIVER_ACTION" in
    ensure) driver_ensure "$pipe" ;;
    stop)   driver_stop ;;
    status)
      running="$(driver_pid)" || running=''
      if [ -n "$running" ]; then
        ok "gc_controller is running (pid $running), pipe $PIPE_DIR/$pipe"
      elif [ -z "$DRIVER_BIN" ]; then
        note "the GameCube controller driver was not built; re-run DolBundler/build.sh"
        exit 1
      else
        note "gc_controller is not running"
        exit 1
      fi
      ;;
  esac
  exit 0
fi

# --- subcommands -------------------------------------------------------------
# Both act on a game that is already recompiled, so they need neither the disc
# image nor a compiler.

require_fields() {
  [ -n "$ARG_DISC_ID" ]   || die "$1 needs --disc-id"
  [ -n "$ARG_GAME_ROOT" ] || die "$1 needs --game-root"
  [ -n "$ARG_MODULE" ]    || die "$1 needs --module"
  [ -n "$ARG_TITLE" ]     || die "$1 needs --title"
  [ -d "$ARG_GAME_ROOT" ] || die "the extracted disc is missing from $ARG_GAME_ROOT"
  [ -f "$ARG_MODULE" ]    || die "the recompiled module is missing from $ARG_MODULE"
}

register_game() {
  /usr/bin/python3 "$SELF_DIR/make_game_app.py" \
    --name "$ARG_TITLE" --disc-id "$ARG_DISC_ID" --game-root "$ARG_GAME_ROOT" \
    --module "$ARG_MODULE" --runtime "$MG_BUILD" --user-dir "$USER_DIR" \
    --graphics "$GRAPHICS_BACKEND" --audio "$AUDIO_BACKEND" \
    --platform "$ARG_PLATFORM" \
    --library "$LIBRARY" --covers "$COVERS" "$@"
}

if [ "$MODE" = play ]; then
  require_fields play
  mkdir -p "$USER_DIR/Logs"
  # Dolphin only scans Pipes at startup, so any pipe a port was set to has to
  # exist before the runtime does. The window runs this step first so its output
  # is visible; doing it here too is what makes the bare command line work.
  while read -r pipe; do
    [ -n "$pipe" ] && driver_ensure "$pipe"
  done <<<"$(configured_pipes)"
  # Mirrors the generated .app's launcher. The bundle keeps its own copy on
  # purpose: it has to run with DolBundler uninstalled.
  # macOS ships bash 3.2, where "${arr[@]}" on an *empty* array trips `set -u`
  # with "unbound variable". No audio backend chosen is the default, so the
  # array is empty on nearly every launch; ${arr[@]+...} expands to nothing
  # instead of erroring.
  audio_args=()
  [ -n "$AUDIO_BACKEND" ] && audio_args=(--audio "$AUDIO_BACKEND")
  exec "$MG_BUILD/moderngekko-run" \
    --game "$ARG_GAME_ROOT" \
    --module "$ARG_MODULE" \
    --user-dir "$USER_DIR" \
    --title "$ARG_TITLE" \
    --graphics "$GRAPHICS_BACKEND" \
    "${audio_args[@]+"${audio_args[@]}"}" \
    >>"$USER_DIR/Logs/$ARG_DISC_ID.log" 2>&1
fi

if [ "$MODE" = make-app ]; then
  require_fields make-app
  mkdir -p "$APPS_DIR"
  app="$(register_game --app --out-dir "$APPS_DIR")" \
    || die "could not build the app bundle"
  info app "$app"
  ok "$app"
  exit 0
fi

command -v cmake >/dev/null || die "cmake is required to compile the recompiled module"
command -v ninja >/dev/null || die "ninja is required to compile the recompiled module"

# "MarioParty4" -> "Mario Party 4". Only splits lower->upper and lower->digit,
# so all-caps IDs and names like NBA2K3 are left alone.
prettify() {
  printf '%s' "$1" | sed -E 's/([a-z])([A-Z])/\1 \2/g; s/([a-z])([0-9])/\1 \2/g'
}

process_one() {
  local image="$1"
  [ -f "$image" ] || die "no such file: $image"
  info image "$image"

  printf '%s%s%s\n' "$bold" "RecompGC - $(basename "$image")" "$off"

  step 1 4 "Extracting the disc"
  local extract_log; extract_log="$(mktemp -t recompgc-extract)"
  "$MG_BUILD/ModernGekko" --extract "$image" 2>&1 | tee "$extract_log"
  [ "${PIPESTATUS[0]}" -eq 0 ] || die "extraction failed (see the log above)"
  local game_root
  game_root="$(sed -n 's/^.*: "\(.*\)"$/\1/p' "$extract_log" | tail -1)"
  rm -f "$extract_log"
  [ -d "$game_root" ] || die "could not determine where the disc was extracted"
  info game_root "$game_root"
  ok "$game_root"

  step 2 4 "Reading the game header"
  local info_text; info_text="$("$MG_BUILD/moderngekko-port" inspect "$game_root")" \
    || die "the extracted disc did not validate"
  printf '%s\n' "$info_text" | sed 's/^/    /'
  local raw_name disc_id platform
  raw_name="$(sed -n 's/^Game name: *//p' <<<"$info_text")"
  disc_id="$(sed -n 's/^Disc ID: *//p' <<<"$info_text")"
  platform="$(sed -n 's/^Platform: *//p' <<<"$info_text")"
  [ -n "$disc_id" ] || die "the disc header had no game ID"

  local name
  if [[ "$raw_name" == *" "* ]]; then name="$raw_name"; else name="$(prettify "$raw_name")"; fi
  name="${name//\//-}"; name="${name//:/-}"
  [ -n "$name" ] || name="$disc_id"
  info disc_id "$disc_id"
  info name "$name"
  info platform "$platform"

  local module_suffix=.dylib
  step 3 4 "Recompiling $name to native code"
  if [ "$ARG_BACKEND" = llvm ]; then
    note "PowerPC -> DolIR -> native, in process. The first pass takes a few minutes; later ones are cached."
  else
    note "PowerPC -> C -> native. The first pass takes a few minutes; later ones are cached."
  fi
  local port_log; port_log="$(mktemp -t recompgc-port)"
  "$MG_BUILD/moderngekko-port" build "$game_root" --backend "$ARG_BACKEND" 2>&1 | tee "$port_log"
  [ "${PIPESTATUS[0]}" -eq 0 ] || { rm -f "$port_log"; die "recompilation failed (see the log above)"; }
  local module
  module="$(grep -E '^(built module|cache hit): ' "$port_log" | tail -1 | sed 's/^[^:]*: "//; s/"$//')"
  rm -f "$port_log"
  [ -f "$module" ] || die "the recompiler did not report a module path"
  info module "$module"
  info backend "$ARG_BACKEND"
  ok "$(du -h "$module" | cut -f1 | tr -d ' ') native module"

  # Also park it where a bare `moderngekko-run --game ...` looks, so the game is
  # playable without going through the generated app.
  mkdir -p "$USER_DIR/StaticRecompModules"
  cp -f "$module" "$USER_DIR/StaticRecompModules/g${disc_id}_recomp${module_suffix}"

  # register_game reads these; the pipeline and the subcommands share one path
  # into make_game_app.py.
  ARG_TITLE="$name"; ARG_DISC_ID="$disc_id"; ARG_GAME_ROOT="$game_root"
  ARG_MODULE="$module"; ARG_PLATFORM="$platform"

  local app=""
  if [ "$MAKE_APP" -eq 1 ]; then
    step 4 4 "Building $name.app"
    mkdir -p "$APPS_DIR"
    app="$(register_game --source-image "$image" --app --out-dir "$APPS_DIR")" \
      || die "could not build the app bundle"
    info app "$app"
    ok "$app"
  else
    step 4 4 "Adding $name to the library"
    register_game --source-image "$image" >/dev/null \
      || die "could not add the game to the library"
    ok "in the library - play it from DolBundler"
  fi

  printf '\n%s%s is ready.%s %s(%s, %s)%s\n' \
    "$green" "$name" "$off" "$dim" "$disc_id" "$platform" "$off"
  if [ -n "$app" ] && [ "$AUTO_OPEN" -eq 1 ]; then
    printf '%sOpening it now. It also lives in %s.%s\n' "$dim" "$APPS_DIR" "$off"
    open "$app"
  elif [ -z "$app" ]; then
    printf '%sPlay it from DolBundler, or add --app to build a .app in %s.%s\n' \
      "$dim" "$APPS_DIR" "$off"
  fi
  emit ok
}

if [ "${#IMAGES[@]}" -eq 0 ]; then
  echo "usage: $(basename "$0") [--porcelain] [--app] [--no-open] <disc-image.iso> [...]" >&2
  exit 2
fi

for image in "${IMAGES[@]}"; do
  process_one "$image"
done
