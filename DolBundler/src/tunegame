# --- small utilities -------------------------------------------------------


def redact_home(text: str) -> str:
    """Paths in a committed record belong to whoever reads it, not to whoever
    wrote it. The store's own copy of a report keeps them absolute."""
    home = os.path.expanduser("~")
    return text.replace(home, "~") if home and home != "/" else text


def now_iso() -> str:
    return _dt.datetime.now(_dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def sha256_file(path: str) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            h.update(block)
    return h.hexdigest()


def human_size(path: str) -> str:
    total = 0
    if os.path.isdir(path):
        for root, _, files in os.walk(path):
            for name in files:
                try:
                    total += os.path.getsize(os.path.join(root, name))
                except OSError:
                    pass
    elif os.path.isfile(path):
        total = os.path.getsize(path)
    for unit in ("B", "KB", "MB", "GB"):
        if total < 1024 or unit == "GB":
            return "%.0f %s" % (total, unit) if unit == "B" else "%.1f %s" % (total, unit)
        total /= 1024.0
    return "?"


class Log:
    """Progress to the terminal and, verbatim, to the store's tunegame.log."""

    def __init__(self):
        self.file = None
        self.started = time.monotonic()

    def attach(self, path: str):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        if self.file:
            self.file.close()
        self.file = open(path, "a")
        self.file.write("\n==== %s ====\n" % now_iso())

    def __call__(self, message: str):
        stamp = "[%6.0fs] " % (time.monotonic() - self.started)
        line = stamp + message
        print(line, flush=True)
        if self.file:
            self.file.write(line + "\n")
            self.file.flush()


log = Log()


def die(message: str, code: int = 1):
    print("error: " + message, file=sys.stderr, flush=True)
    if log.file:
        log.file.write("error: " + message + "\n")
        log.file.flush()
    sys.exit(code)


def git(*args: str) -> str:
    try:
        return subprocess.run(["git", "-C", REPO_ROOT] + list(args), capture_output=True,
                              text=True, check=False).stdout.strip()
    except OSError:
        return ""


def recompiler_commit() -> str:
    """The last commit that touched the recompiler. A record made against an
    older one is stale in the one way that matters: its profile may no longer
    describe the functions the emitter produces."""
    commit = git("log", "-1", "--format=%h", "--",
                 "ModernGekko/vendor/dolphin/DolRecomp", "ModernGekko/vendor/dolphin/GXRuntime")
    dirty = git("status", "--porcelain", "--",
                "ModernGekko/vendor/dolphin/DolRecomp", "ModernGekko/vendor/dolphin/GXRuntime")
    return (commit or "unknown") + ("+dirty" if dirty else "")


def running_runners() -> list:
    out = subprocess.run(["pgrep", "-fl", "moderngekko-run"], capture_output=True, text=True).stdout
    return [line for line in out.splitlines() if "pgrep" not in line]


# --- the library -----------------------------------------------------------


def library_games(wanted=None) -> list:
    """(disc id, name, game root) for games whose extracted disc is present."""
    try:
        games = json.load(open(LIBRARY)).get("games", [])
    except Exception:
        games = []
    by_id = {g.get("disc_id", ""): g for g in games if g.get("disc_id")}
    result = []
    for disc_id in (wanted or sorted(by_id)):
        game = by_id.get(disc_id)
        if game is None:
            continue
        root = game.get("game_root", "")
        if not os.path.isfile(os.path.join(root, "sys", "main.dol")):
            continue
        result.append((disc_id, game.get("name") or disc_id, root))
    return result


def recompgc_path() -> str:
    for candidate in (os.path.join(SELF_DIR, "recompgc"),
                      os.path.expanduser("~/Applications/DolBundler.app/Contents/Resources/recompgc")):
        if os.access(candidate, os.X_OK) and os.path.isfile(
                os.path.join(os.path.dirname(candidate), "toolchain.conf")):
            return candidate
    return ""


# --- the store and the record ---------------------------------------------


class Store:
    """Everything a deep dive leaves behind for one title, big things
    included, under Application Support. results.json is the memory across
    runs: a stage whose inputs have not changed is not repeated."""

    def __init__(self, disc_id: str):
        self.disc_id = disc_id
        self.dir = os.path.join(STORE_ROOT, disc_id)
        # A dive writes gigabytes here; Spotlight indexing them is one more
        # thing running beside a bench.
        os.makedirs(STORE_ROOT, exist_ok=True)
        open(os.path.join(STORE_ROOT, ".metadata_never_index"), "a").close()
        os.makedirs(os.path.join(self.dir, "runs"), exist_ok=True)
        os.makedirs(os.path.join(self.dir, "profiles"), exist_ok=True)
        os.makedirs(os.path.join(self.dir, "modules"), exist_ok=True)
        self.results_path = os.path.join(self.dir, "results.json")
        self.results = {}
        if os.path.isfile(self.results_path):
            try:
                self.results = json.load(open(self.results_path))
            except Exception:
                self.results = {}

    def path(self, *parts: str) -> str:
        return os.path.join(self.dir, *parts)

    def save(self):
        tmp = self.results_path + ".tmp"
        json.dump(self.results, open(tmp, "w"), indent=2, sort_keys=True)
        os.replace(tmp, self.results_path)

    @property
    def scene(self) -> str:
        return self.path("scene.sav")


def record_dir(disc_id: str) -> str:
    return os.path.join(RECORD_ROOT, disc_id)


def tuned_dylib_path(store: Store) -> str:
    chunk = store.results.get("chunk", DEFAULT_CHUNK)
    return store.path("modules", "tuned-c%d" % chunk, "module-build", "g%s_recomp.dylib" % store.disc_id)


def resolve_module(game, store: Store, spec: str) -> str:
    """`tuned` names the store's tuned module, rebuilt from the merged profile
    if `clean` took it away; anything else is a path."""
    if spec != "tuned":
        if not os.path.isfile(spec):
            die("no module at " + spec)
        return spec
    path = tuned_dylib_path(store)
    if os.path.isfile(path):
        return path
    merged = store.path("profiles", "merged.profdata")
    if not os.path.isfile(merged):
        die("no tuned module and no merged profile in the store; run the deep dive first")
    ensure_tools()
    log("rebuilding the tuned module from the store's profile")
    b = build_module(store.disc_id, game.dol, os.path.dirname(os.path.dirname(path)), pgo=merged,
                     chunk=store.results.get("chunk", DEFAULT_CHUNK))
    return b.dylib


def clean_store(store: Store, keep_tuned: bool):
    """Drop what a finished dive no longer needs. The scene, the merged
    profile, the logs and results.json stay, so `bench`, `ab` and a resumed
    run still work; the tuned module is a 145 s rebuild from the profile."""
    freed = 0
    modules = store.path("modules")
    tuned_dir = os.path.dirname(os.path.dirname(tuned_dylib_path(store)))
    for name in sorted(os.listdir(modules)) if os.path.isdir(modules) else []:
        path = os.path.join(modules, name)
        if keep_tuned and os.path.realpath(path) == os.path.realpath(tuned_dir):
            continue
        freed += sum(os.path.getsize(os.path.join(r, f)) for r, _, fs in os.walk(path) for f in fs)
        shutil.rmtree(path, ignore_errors=True)
    profiles = store.path("profiles")
    for name in sorted(os.listdir(profiles)) if os.path.isdir(profiles) else []:
        path = os.path.join(profiles, name)
        if os.path.isdir(path):
            freed += sum(os.path.getsize(os.path.join(r, f)) for r, _, fs in os.walk(path) for f in fs)
            shutil.rmtree(path, ignore_errors=True)
    candidates = store.path("candidates")
    if os.path.isdir(candidates):
        freed += sum(os.path.getsize(os.path.join(r, f)) for r, _, fs in os.walk(candidates) for f in fs)
        shutil.rmtree(candidates, ignore_errors=True)
    log("cleaned %s: %.0f MB freed" % (store.dir, freed / 1e6))


def read_record(disc_id: str) -> dict:
    path = os.path.join(record_dir(disc_id), "tuning.conf")
    record = {}
    if os.path.isfile(path):
        for line in open(path):
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            record[key.strip()] = value.strip().strip('"')
    return record


# --- the recompiler --------------------------------------------------------


def ensure_tools():
    if not os.access(DOLRECOMP, os.X_OK):
        script = os.path.join(REPO_ROOT, "ios", "build-dolrecomp-llvm20.sh")
        if not os.access(script, os.X_OK):
            die("no %s and no %s to build it" % (DOLRECOMP, script))
        log("building the pinned LLVM 20 recompiler; the first one takes a few minutes")
        if subprocess.run([script]).returncode != 0 or not os.access(DOLRECOMP, os.X_OK):
            die("could not build the recompiler")
    if not os.access(RUNNER, os.X_OK):
        die("no %s; build ModernGekko first (DolBundler/build.sh)" % RUNNER)
    for tool in ("cmake", "ninja", "clang"):
        if not shutil.which(tool):
            die("%s is not on PATH; brew install %s" % (tool, tool))
    if not os.access(LLVM_PROFDATA, os.X_OK):
        die("no %s; brew install llvm@20" % LLVM_PROFDATA)


class BuildResult:
    def __init__(self, dylib, generated, recompile_log, link_log, seconds, stale, chunks, metadata):
        self.dylib = dylib
        self.generated = generated
        self.recompile_log = recompile_log
        self.link_log = link_log
        self.seconds = seconds
        self.stale = stale
        self.chunks = chunks
        self.metadata = metadata


def parse_llvm_metadata(text: str) -> dict:
    m = re.search(r"LLVM metadata: (.*)", text)
    if not m:
        return {}
    return dict(re.findall(r"(\w+)=(\S+)", m.group(1)))


def build_module(disc_id: str, dol: str, out: str, pgo: str = "", chunk: int = 0,
                 extra_env: dict = None, keep_objects: bool = False) -> BuildResult:
    """One Mac module: DOL -> DolIR -> arm64 objects -> g<ID>_recomp.dylib.
    pgo is '' (plain), 'gen' (instrumented), or a .profdata path (guided).
    Mirrors recompios's collect_profile / recompile_game exactly, on purpose:
    a module measured here has to be built the way the phone's will be."""
    generated = os.path.join(out, "generated")
    module_build = os.path.join(out, "module-build")
    dylib = os.path.join(module_build, "g%s_recomp.dylib" % disc_id)
    recompile_log = os.path.join(out, "recompile.log")
    link_log = os.path.join(out, "link.log")
    if os.path.isfile(dylib) and os.path.isfile(recompile_log):
        text = open(recompile_log, errors="replace").read()
        stale = text.count("PGO profile stale")
        m = re.search(r"objects: .*\((\d+) files\)", text)
        return BuildResult(dylib, generated, recompile_log, link_log, 0.0, stale,
                           int(m.group(1)) if m else 0, parse_llvm_metadata(text))

    shutil.rmtree(out, ignore_errors=True)
    os.makedirs(out)
    # The object cache is keyed on the codegen fingerprint, and a guided
    # build folds the profile's hash into that -- so guided objects are never
    # reused (every dive makes a new profile) and would sit at ~600 MB a
    # build, a variant, a title. The instrumented build shares recompios's
    # cache, which is the reuse worth having: 11 s instead of three minutes.
    if pgo == "gen":
        cache = os.path.join(LLVM_CACHE_ROOT, disc_id + "-profile")
    elif pgo:
        cache = "off"
    else:
        cache = os.path.join(LLVM_CACHE_ROOT, disc_id + "-mac")
    if cache != "off":
        os.makedirs(cache, exist_ok=True)
    env = dict(os.environ)
    env.update({
        "DOLRECOMP_LLVM_TARGET": MAC_TARGET,
        "DOLRECOMP_LLVM_CPU": LLVM_CPU,
        "DOLRECOMP_LLVM_CACHE": cache,
        "DOLRECOMP_LLVM_SYMBOL_PREFIX": "g%s_" % disc_id,
        "DOLRECOMP_LLVM_PGO_STALE": "warn",
    })
    env.pop("DOLRECOMP_LLVM_PGO", None)
    env.pop("DOLRECOMP_LLVM_PROFILE", None)
    env.pop("DOLRECOMP_LLVM_CHUNK_INSTRUCTIONS", None)
    if pgo == "gen":
        env["DOLRECOMP_LLVM_PGO"] = "gen"
    elif pgo:
        env["DOLRECOMP_LLVM_PGO"] = "use"
        env["DOLRECOMP_LLVM_PROFILE"] = pgo
    if chunk:
        env["DOLRECOMP_LLVM_CHUNK_INSTRUCTIONS"] = str(chunk)
    env.update(extra_env or {})

    started = time.monotonic()
    with open(recompile_log, "w") as f:
        rc = subprocess.run([DOLRECOMP, "-j%d" % JOBS, "--gamecube", "--backend", "llvm", dol, out],
                            stdin=subprocess.DEVNULL, stdout=f, stderr=subprocess.STDOUT, env=env).returncode
    if rc != 0 or not os.path.isfile(os.path.join(generated, "generated.h")):
        tail = "".join(open(recompile_log, errors="replace").readlines()[-15:])
        raise RuntimeError("recompile failed (exit %d):\n%s" % (rc, tail))
    shutil.copyfile(dol, os.path.join(generated, "main.dol"))

    cmake_env = dict(os.environ, CMAKE_NINJA_FORCE_RESPONSE_FILE="1")
    with open(link_log, "w") as f:
        configure = subprocess.run(
            ["cmake", "-S", MODULE_TEMPLATE, "-B", module_build, "-G", "Ninja",
             "-DCMAKE_BUILD_TYPE=Release", "-DCMAKE_C_COMPILER=clang",
             "-DGAME_ID=%s" % disc_id, "-DGENERATED_DIR=%s" % generated,
             "-DGXRUNTIME_DIR=%s" % GXRUNTIME_DIR, "-DCHASSIS_ABI_DIR=%s" % CHASSIS_ABI_DIR],
            stdout=f, stderr=subprocess.STDOUT, env=cmake_env).returncode
        if configure == 0:
            configure = subprocess.run(["cmake", "--build", module_build, "-j%d" % JOBS],
                                       stdout=f, stderr=subprocess.STDOUT, env=cmake_env).returncode
    if configure != 0 or not os.path.isfile(dylib):
        tail = "".join(open(link_log, errors="replace").readlines()[-15:])
        raise RuntimeError("module link failed:\n%s" % tail)

    text = open(recompile_log, errors="replace").read()
    stale = text.count("PGO profile stale")
    m = re.search(r"objects: .*\((\d+) files\)", text)
    chunks = int(m.group(1)) if m else 0
    if not keep_objects:
        # A quarter of a gigabyte of objects per variant, and the dylib is
        # what gets run; the object cache keeps the next build quick.
        shutil.rmtree(os.path.join(generated, "chunks"), ignore_errors=True)
        shutil.rmtree(os.path.join(module_build, "CMakeFiles"), ignore_errors=True)
    return BuildResult(dylib, generated, recompile_log, link_log, time.monotonic() - started,
                       stale, chunks, parse_llvm_metadata(text))


