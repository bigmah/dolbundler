def read_toolchain_conf() -> dict:
    """DolBundler/build.sh writes toolchain.conf beside the scripts it installs.
    In a checkout it does not exist; everything it says can be derived from
    where this file sits, so a developer can run this without building the
    app."""
    conf = {}
    path = os.path.join(SELF_DIR, "toolchain.conf")
    if os.path.isfile(path):
        for line in open(path):
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            conf[key.strip()] = value.strip()
    return conf


