}

# What gets pressed, and when. The aim is to walk an arbitrary title from its
# boot logos into something that looks like play with no knowledge of the
# game: START and A get past almost every title screen, mode select and
# confirmation there is, and after that the stick is kept moving and A is
# tapped so that whatever is running gets input rather than an idle screen.
# Nothing here needs to be right for a particular game; it needs to be
# harmless for all of them, which is why B (back) is never sent and START
# only ever comes as a pair once play is assumed -- a pause and an unpause.
write_pump() {  # <path>
  cat > "$1" <<'PY'
import errno, os, random, sys, time

fifo, seconds = sys.argv[1], float(sys.argv[2])
deadline = time.monotonic() + seconds
random.seed(1)

# Dolphin opens the FIFO read-only and non-blocking at startup; until it has,
# opening the write end fails with ENXIO. Poll rather than block so a runner
# that never starts does not leave this process hanging.
fd = None
while fd is None and time.monotonic() < deadline:
    try:
        fd = os.open(fifo, os.O_WRONLY | os.O_NONBLOCK)
    except OSError as e:
        if e.errno not in (errno.ENXIO, errno.ENOENT):
            raise
        time.sleep(0.5)
if fd is None:
    sys.exit(0)


def send(line):
    try:
        os.write(fd, (line + "\n").encode())
    except BlockingIOError:
        pass
    except BrokenPipeError:
        sys.exit(0)


def tap(button, hold=0.25):
    send("PRESS " + button)
    time.sleep(hold)
    send("RELEASE " + button)


def wait(t):
    end = time.monotonic() + t
    while time.monotonic() < end:
        if time.monotonic() >= deadline:
            send("SET MAIN 0.5 0.5")
            sys.exit(0)
        time.sleep(min(0.1, end - time.monotonic()))


# Menus: alternate START and A, with an occasional nudge down the list so the
# second entry gets a turn. This is wall time with the speed limiter off, so
# ninety seconds is several guest minutes -- enough for any intro movie.
menu_end = time.monotonic() + min(90.0, seconds * 0.5)
turn = 0
while time.monotonic() < menu_end:
    tap("START" if turn % 3 == 0 else "A")
    wait(2.0)
    if turn % 4 == 3:
        tap("D_DOWN")
        wait(0.5)
    turn += 1

# Play: keep the stick moving, tap A now and then, and once in a while send a
# START pair -- a pause and unpause during play, one more screen advanced if
# the title is still in a menu.
last_start = time.monotonic()
while True:
    x = random.choice([0.0, 0.25, 0.5, 0.75, 1.0])
    y = random.choice([0.0, 0.25, 0.5, 0.75, 1.0])
    send("SET MAIN %.2f %.2f" % (x, y))
    wait(random.uniform(0.8, 1.8))
    if random.random() < 0.5:
        tap("A")
    if random.random() < 0.15:
        tap(random.choice(["X", "Y", "R", "L"]))
    if time.monotonic() - last_start > 30.0:
        tap("START")
        wait(1.0)
        tap("START")
        last_start = time.monotonic()
PY
}

# The one line the chassis prints at shutdown, turned into a report a person
# can read. Cycles are the guest's; the rest are the chassis's own counters
# and say how much of the run the module itself executed.
profile_report() {  # <run log> <report path> <name> <wall seconds>
  /usr/bin/python3 - "$1" "$2" "$3" "$4" "$GEKKO_HZ" <<'PY'
import re, sys
log, report, name, wall, hz = sys.argv[1], sys.argv[2], sys.argv[3], float(sys.argv[4]), float(sys.argv[5])
text = open(log, errors="replace").read()
lines = [l for l in text.splitlines() if "[staticrecomp] shutdown:" in l]
if not lines:
    print("the run left no shutdown counters")
    sys.exit(1)
fields = dict(re.findall(r"(\w+)=(\d+)", lines[-1]))
cycles = int(fields.get("cycles", 0))
guest = cycles / hz
rate = guest / wall if wall else 0.0
out = [
    f"profile of {name}",
    f"guest time covered: {guest / 60:.1f} min ({cycles} cycles)",
    f"wall time: {wall:.0f} s ({rate:.2f}x real time on this Mac)",
    f"module dispatches: {fields.get('native', '?')}",
    f"instructions the module could not run: {fields.get('hook_fb', '?')} (hooks), {fields.get('fallback', '?')} (fallback)",
    f"self-modified code taken from the module: {fields.get('smc_lost', '?')} bytes in {fields.get('smc_failed', '?')} chunk(s)",
    f"poll reads skipped: {fields.get('poll_reads', '?')} ({fields.get('poll_yields', '?')} yields)",
    "",
    lines[-1].strip(),
]
open(report, "w").write("\n".join(out) + "\n")
print(f"{guest / 60:.1f} guest minutes played at {rate:.1f}x; "
      f"{fields.get('smc_lost', '?')} B of self-modifying code lost to the interpreter")
PY
}

# Where the profile step leaves its result for the build step. Empty when no
# profile could be gathered, in which case the build goes ahead without one.
PROFILE_DATA=''

collect_profile() {  # <disc id> <name> <game root> <module dir being built>
  local disc_id="$1" name="$2" root="$3" out="$4"
  local work="$out/profile-work"
  local dol="$root/sys/main.dol"
  local instrumented="$work/instrumented/generated"
  local module_build="$work/module-build"
  local user_dir="$work/user"
  PROFILE_DATA=''

  [ -x "$MG_BUILD/moderngekko-run" ] \
    || { note "no $MG_BUILD/moderngekko-run to play the game with; skipping the profile"; return 1; }
  command -v cmake >/dev/null && command -v ninja >/dev/null \
    || { note "cmake and ninja are needed to link the instrumented copy; skipping the profile"; return 1; }

  rm -rf "$work"
  mkdir -p "$work" "$LLVM_CACHE_DIR/$disc_id-profile"

  # 1. The same DOL, recompiled for this Mac with counters in every function.
  # Same symbol prefix as the phone build, because the profile is keyed on
  # function names; same CPU for the same reason it is everywhere else.
  note "recompiling an instrumented copy for this Mac across $JOBS jobs"
  DOLRECOMP_LLVM_TARGET="$MAC_LLVM_TARGET" \
  DOLRECOMP_LLVM_CPU="$LLVM_CPU" \
  DOLRECOMP_LLVM_CACHE="$LLVM_CACHE_DIR/$disc_id-profile" \
  DOLRECOMP_LLVM_SYMBOL_PREFIX="g${disc_id}_" \
  DOLRECOMP_LLVM_PGO=gen \
  DOLRECOMP_LLVM_CHUNK_INSTRUCTIONS="$TUNING_CHUNK" \
    "$DOLRECOMP_IOS" -j"$JOBS" --gamecube --backend llvm "$dol" "$work/instrumented" \
      </dev/null >"$work/instrumented.log" 2>&1
  if [ $? -ne 0 ] || [ ! -f "$instrumented/generated.h" ]; then
    tail -20 "$work/instrumented.log" | strip_colour
    note "the instrumented recompile failed; building without a profile"
    return 1
  fi
  cp -f "$dol" "$instrumented/main.dol" || return 1

  # 2. Linked into a module this Mac's runtime can load. The template sees
  # pgo=gen in the header and links compiler-rt's profile runtime in.
  note "linking it"
  if ! CMAKE_NINJA_FORCE_RESPONSE_FILE=1 cmake -S "$MG_SRC/vendor/dolphin/module-template" \
        -B "$module_build" -G Ninja -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_COMPILER=clang -DGAME_ID="$disc_id" \
        -DGENERATED_DIR="$instrumented" \
        -DGXRUNTIME_DIR="$MG_SRC/vendor/dolphin/GXRuntime" \
        -DCHASSIS_ABI_DIR="$MG_SRC/vendor/dolphin/Source/Core/Core/PowerPC/StaticRecomp" \
        >"$work/link.log" 2>&1 \
     || ! cmake --build "$module_build" -j"$JOBS" >>"$work/link.log" 2>&1 \
     || [ ! -f "$module_build/g${disc_id}_recomp.dylib" ]; then
    tail -20 "$work/link.log" | strip_colour
    note "the instrumented module did not link; building without a profile"
    return 1
  fi

  # 3. Play it. Headless, silent, speed limiter off, its own user directory so
  # nothing here touches the desktop app's settings, and a watchdog behind
  # the runtime's own timer for the run that never comes back. The profile is
  # written when the runtime shuts the module down, so a run that has to be
  # killed leaves nothing, and that is reported as such rather than merged.
  note "playing it for $PROFILE_SECONDS seconds with scripted input"
  write_pipe_pad_config "$user_dir" || return 1
  write_pump "$work/pump.py"
  mkdir -p "$work/raw"
  local started; started="$(date +%s)"
  /usr/bin/python3 "$work/pump.py" "$user_dir/Pipes/pad1" $((PROFILE_SECONDS + 15)) &
  local pump=$!
  LLVM_PROFILE_FILE="$work/raw/%p.profraw" \
  MODERNGEKKO_RUN_SECONDS="$PROFILE_SECONDS" \
  MODERNGEKKO_EMULATION_SPEED=0 \
    "$MG_BUILD/moderngekko-run" --game "$root" \
      --module "$module_build/g${disc_id}_recomp.dylib" --user-dir "$user_dir" \
      --headless --graphics Null --audio "No Audio Output" \
      </dev/null >"$work/run.log" 2>&1 &
  local runner=$!
  local waited=0
  while kill -0 "$runner" 2>/dev/null; do
    sleep 1
    waited=$((waited + 1))
    if [ "$waited" -gt $((PROFILE_SECONDS + 180)) ]; then
      note "the game did not stop on its own; giving up on it"
      kill "$runner" 2>/dev/null; sleep 2; kill -9 "$runner" 2>/dev/null
      break
    fi
  done
  wait "$runner" 2>/dev/null
  local status=$?
  kill "$pump" 2>/dev/null; wait "$pump" 2>/dev/null
  local wall=$(( $(date +%s) - started ))
  cp -f "$work/run.log" "$out/profile-run.log" 2>/dev/null
  if ! ls "$work"/raw/*.profraw >/dev/null 2>&1; then
    grep -a "StaticRecomp\|error" "$work/run.log" | tail -5 | strip_colour
    note "the run (exit $status) wrote no profile; building without one"
    return 1
  fi

  # 4. Merge, and say what the run covered.
  if ! $LLVM_PROFDATA merge -o "$work/profile.profdata" "$work"/raw/*.profraw >"$work/merge.log" 2>&1; then
    tail -5 "$work/merge.log"
    note "llvm-profdata could not merge the counters; building without a profile"
    return 1
  fi
  # A profile in which nothing ran is worse than none: the optimiser would
  # read every function as cold and build the whole game for size. It
  # happens when the module was rejected at load and the game ran on the
  # interpreter instead, which the run log says and the counters do not.
  local executed
  executed="$($LLVM_PROFDATA show "$work/profile.profdata" 2>/dev/null \
    | sed -n 's/^Total count: *//p' | head -1)"
  if [ -z "$executed" ] || [ "$executed" -eq 0 ] 2>/dev/null; then
    grep -a "StaticRecomp\|rejected" "$work/run.log" | tail -3 | strip_colour
    note "the run never executed the instrumented module; building without a profile"
    return 1
  fi
  local summary
  if summary="$(profile_report "$work/run.log" "$out/profile-report.txt" "$name" "$wall")"; then
    ok "$summary"
  else
    note "$summary"
  fi
  # The functions the run spent its time in, by guest address. When a title
  # is still slow on the phone this is the first thing to read: one function
  # far ahead of the rest is a wait loop or a decoder, and either is a lead.
  {
    printf '\nhottest generated functions (LLVM block counts, most first):\n'
    $LLVM_PROFDATA show --topn=12 "$work/profile.profdata" 2>/dev/null \
      | sed -n '/^Top /,$p' | tail -n +2
  } >> "$out/profile-report.txt"
  mv -f "$work/profile.profdata" "$out/profile.profdata"
  # The instrumented objects and the dylib are a quarter of a gigabyte a game
  # and have done their job; the object cache keeps the next collection quick.
  rm -rf "$work"
  PROFILE_DATA="$out/profile.profdata"
  return 0
}

# How many of the pipeline's steps one game takes: the profile and the
# recompile are separate headings, because the window shows the heading and
# the profile is the longer of the two.
steps_per_game() { [ "$PROFILE" -eq 1 ] && echo 2 || echo 1; }

# `profile` rebuilds a game that is already in the store; `send` leaves one
# alone. Kept apart from --force, which also rebuilds the recompiler.
REBUILD=0

# The phone recompile itself, once the profile question is settled. Leaves the
# number of chunks it built and how many of them the profile did not describe
# for the caller to judge.
STALE_CHUNKS=0; BUILT_CHUNKS=0
phone_recompile() {  # <disc id> <name> <dol> <module dir being built>
  local disc_id="$1" name="$2" dol="$3" out="$4"
  local generated="$out/generated"
  if [ -n "$PROFILE_DATA" ]; then
    note "PowerPC -> DolIR -> arm64 iPhone objects, profile-guided, across $JOBS jobs. Minutes, and gigabytes of RAM for a large game."
  else
    note "PowerPC -> DolIR -> arm64 iPhone objects across $JOBS jobs. Minutes, and gigabytes of RAM for a large game."
  fi

  # Every game in the app exports the same handful of module symbols, so each
  # one needs its own C-identifier prefix or the second to be linked collides
  # with the first. With a profile, the emitter is told to warn rather than
  # stop on a function the profile does not describe: the module is still
  # correct, that function is merely built as it would have been anyway, and
  # how many there were is reported below. The chunk size comes from the
  # title's tuning record when it has one, and the profile was gathered at
  # the same size -- a profile is keyed per function and a function is a
  # chunk, so the two have to agree.
  # No object cache for a guided build: the cache key folds in the profile's
  # hash, so those objects are never reused and were piling up at 400 MB a
  # title per profile. A plain build still caches.
  DOLRECOMP_LLVM_TARGET="$LLVM_TARGET" \
  DOLRECOMP_LLVM_CPU="$LLVM_CPU" \
  DOLRECOMP_LLVM_CACHE="${PROFILE_DATA:+off}${PROFILE_DATA:-$LLVM_CACHE_DIR/$disc_id}" \
  DOLRECOMP_LLVM_SYMBOL_PREFIX="g${disc_id}_" \
  DOLRECOMP_LLVM_PGO="${PROFILE_DATA:+use}" \
  DOLRECOMP_LLVM_PROFILE="$PROFILE_DATA" \
  DOLRECOMP_LLVM_PGO_STALE=warn \
  DOLRECOMP_LLVM_CHUNK_INSTRUCTIONS="$TUNING_CHUNK" \
    "$DOLRECOMP_IOS" -j"$JOBS" --gamecube --backend llvm "$dol" "$out" \
      </dev/null 2>&1 | tee "$out/recompile.log" | strip_colour
  if [ "${PIPESTATUS[0]}" -ne 0 ] || [ ! -f "$generated/generated.h" ]; then
    rm -rf "$out"
    die "recompiling $name for iPhone failed (see the log above)"
  fi

  STALE_CHUNKS=0; BUILT_CHUNKS=0
  if [ -n "$PROFILE_DATA" ]; then
    STALE_CHUNKS="$(grep -c 'PGO profile stale' "$out/recompile.log" || true)"
    BUILT_CHUNKS="$(sed -n 's/.*objects: .*(\([0-9]*\) files).*/\1/p' "$out/recompile.log" | tail -1)"
    : "${BUILT_CHUNKS:=0}"
    if ! module_is_profiled "$out"; then
      note "warning: the module does not record the profile it was built with; check $out/recompile.log"
    elif [ "$STALE_CHUNKS" -gt 0 ]; then
      note "warning: $STALE_CHUNKS chunk(s) had functions the profile did not describe and were built unguided; see $out/recompile.log"
    else
      ok "every generated function matched the profile"
    fi
  fi
}

recompile_game() {  # <disc id> <name> <game root> <first step index> <total steps>
  local disc_id="$1" name="$2" root="$3" index="$4" total="$5"
  local final="$MODULES_DIR/$disc_id"
  # Built beside the module in the store and swapped in at the end, so a
  # re-profile of a game that already works cannot fail half way and leave
  # the next send building an app without it. Nothing else looks in here: the
  # window and embedded_modules() both key on the stamp, which is written last.
  local out="$MODULES_DIR/$disc_id.building"
  local generated="$out/generated"
  local dol="$root/sys/main.dol"
  local want; want="$(module_stamp "$dol" "$disc_id")"

  if [ "$PROFILE" -eq 1 ]; then
    step "$index" "$total" "Profiling $name on this Mac"
  else
    step "$index" "$total" "Recompiling $name for iPhone"
  fi

  if [ "$FORCE" -eq 0 ] && [ "$REBUILD" -eq 0 ] && [ -f "$final/generated/generated.h" ] \
     && [ "$(cat "$final/dol.sha256" 2>/dev/null)" = "$want" ]; then
    # A module built before profiling was part of the pipeline is still a
    # working module; it is only rebuilt when a profile is wanted and it has
    # none. Without --no-profile that is the upgrade every older module gets
    # on its next send.
    if [ "$PROFILE" -eq 0 ] || module_is_profiled "$final"; then
      if module_is_profiled "$final"; then
        ok "$name is already recompiled for iPhone, profile-guided"
      else
        ok "$name is already recompiled for iPhone"
      fi
      [ "$PROFILE" -eq 1 ] && step $((index + 1)) "$total" "Recompiling $name for iPhone"
      info module "$disc_id"
      return 0
    fi
    note "$name is recompiled for iPhone but without a profile"
  fi

  rm -rf "$out"
  mkdir -p "$out" "$LLVM_CACHE_DIR/$disc_id"

  PROFILE_DATA=''
  local tuned=0
  read_tuning_record "$disc_id" || true
  if [ "$PROFILE" -eq 1 ] && [ "$REBUILD" -eq 0 ] && [ -n "$TUNING_PROFILE" ]; then
    # The developer's deep dive on this title: its profile was gathered on the
    # scene that measured heaviest and then played, not on whatever the
    # button-masher reached, and it is what the record's speed was measured
    # with. `profile --disc-id` still collects afresh, for the developer
    # checking the generic path or training on a longer run.
    note "using the profile tuned on ${TUNING_ON%%T*}${TUNING_SPEED:+ (${TUNING_SPEED}x on the tuning Mac)}${TUNING_CHUNK:+, $TUNING_CHUNK-instruction chunks}; DolBundler/tuning/$disc_id"
    if expand_tuning_profile "$TUNING_PROFILE" "$out/profile.profdata"; then
      PROFILE_DATA="$out/profile.profdata"
      tuned=1
      cp -f "$TUNING_ROOT/$disc_id/report.md" "$out/tuning-report.md" 2>/dev/null
    else
      note "could not expand the tuned profile; collecting one instead"
      collect_profile "$disc_id" "$name" "$root" "$out" || rm -rf "$out/profile-work"
    fi
    step $((index + 1)) "$total" "Recompiling $name for iPhone"
  elif [ "$PROFILE" -eq 1 ]; then
    [ -n "$TUNING_CHUNK" ] && note "$TUNING_CHUNK-instruction chunks, from DolBundler/tuning/$disc_id"
    collect_profile "$disc_id" "$name" "$root" "$out" || rm -rf "$out/profile-work"
    step $((index + 1)) "$total" "Recompiling $name for iPhone"
  fi

  phone_recompile "$disc_id" "$name" "$dol" "$out"
  if [ "$tuned" -eq 1 ] && [ "$STALE_CHUNKS" -gt 0 ] \
     && [ $((STALE_CHUNKS * 100)) -gt $((BUILT_CHUNKS * TUNING_STALE_MAX)) ]; then
    # The recompiler has changed enough since the dive that its profile
    # describes functions the emitter no longer produces. A stale function is
    # merely built unguided, which is the plain build; past a tenth of the
    # game that is not the tuned build either, so a fresh generic profile is
    # the better module until the title is tuned again.
    note "the tuned profile no longer matches this recompiler ($STALE_CHUNKS of $BUILT_CHUNKS chunks stale); collecting a fresh one. Run tunegame on $disc_id to re-tune it."
    PROFILE_DATA=''
    collect_profile "$disc_id" "$name" "$root" "$out" || rm -rf "$out/profile-work"
    rm -rf "$generated"
    phone_recompile "$disc_id" "$name" "$dol" "$out"
  fi

  # module-template validates the module against the DOL it came from, so the
  # DOL travels with the objects.
  cp -f "$dol" "$generated/main.dol" \
    || { rm -rf "$out"; die "could not copy $name's main.dol beside its module"; }
  printf '%s' "$name" > "$out/title"
  printf '%s\n' "$want" > "$out/dol.sha256"
  rm -rf "$final"
  mv "$out" "$final" || die "could not move $name's module into place"
  info module "$disc_id"
  ok "$(du -sh "$final/generated" | cut -f1 | tr -d ' ') of arm64 iPhone code"
}

# Every module that is whole, not only the ones being sent now: a game already
# on the phone has to stay linked in or this build would take it away.
embedded_modules() {
  local spec='' dir disc_id
  for dir in "$MODULES_DIR"/*; do
    [ -d "$dir" ] || continue
    disc_id="$(basename "$dir")"
    [ -f "$dir/generated/generated.h" ] || continue
    [ -f "$dir/dol.sha256" ] || continue
    spec="${spec:+$spec;}$disc_id=$dir/generated"
  done
  printf '%s' "$spec"
}

# --- the app -----------------------------------------------------------------

APP_BUNDLE="$REPO_ROOT/build-ios/Release-iphoneos/DolBundler.app"

# ios/build.sh is the command-line entry point for the same thing and stays the
# one place that knows how the app is configured; only the install is done
# here, because the phone was already chosen above and build.sh would go
# looking for it a second time.
build_app() {
  local modules; modules="$(embedded_modules)"
  [ -n "$modules" ] || die "no game has been recompiled for iPhone yet"

  # Xcode drops a removed copy phase from the regenerated project but leaves
  # what that phase already copied in the product directory, which is how a
  # build once reported success while still shipping 300 MB of stale
  # frameworks. The product is cheap to rebuild; the objects behind it are not
  # touched.
  rm -rf "$APP_BUNDLE"

  DOLBUNDLER_TEAM="$TEAM" \
  DOLBUNDLER_DEVICE="$DEVICE_ID" \
  DOLBUNDLER_BUNDLE_ID="$BUNDLE_ID" \
  DOLBUNDLER_NATIVE_MODULES="$modules" \
  DOLBUNDLER_NATIVE_GAME_ID='' \
  DOLBUNDLER_NATIVE_GENERATED_DIR='' \
    "$REPO_ROOT/ios/build.sh" 2>&1 | strip_colour
  [ "${PIPESTATUS[0]}" -eq 0 ] || return 1
  [ -d "$APP_BUNDLE" ] || return 1
}

install_app() {
  if xcrun devicectl device install app --device "$DEVICE_ID" "$APP_BUNDLE" 2>&1 | strip_colour
  then
    return 0
  fi
  {
    echo "The usual causes, in order:"
    echo "  * the phone is locked, or not plugged in and not on this Wi-Fi"
    echo "  * Developer Mode is off under Settings > Privacy & Security"
    echo "  * the signing team's profile does not cover $DEVICE_NAME, which"
    echo "    Xcode can fix only with an Apple ID in Xcode > Settings > Accounts"
  } >&2
  return 1
}

# --- getting the disc onto the phone ------------------------------------------

copy_to_device() {  # <local source> <remote destination> [extra devicectl args]
  local source="$1" destination="$2"; shift 2
  xcrun devicectl device copy to \
    --device "$DEVICE_ID" \
    --domain-type appDataContainer --domain-identifier "$BUNDLE_ID" \
    --source "$source" --destination "$destination" "$@" \
    </dev/null 2>&1 | strip_colour
  return "${PIPESTATUS[0]}"
}

# Whether `copy to --destination Documents/games/GXXE01` writes the source
# directory's contents there ("exact") or the directory itself inside it
# ("parent"). Both readings of the flag are defensible and getting it wrong
# puts a gigabyte where the app will never look, so it is measured once per
# phone with a file small enough that being wrong costs nothing.
device_copy_layout() {
  local recorded="$DEVICES_DIR/$DEVICE_ID/layout"
  if [ "$FORCE" -eq 0 ] && [ -s "$recorded" ]; then
    cat "$recorded"
    return 0
  fi

  local work; work="$(mktemp -d -t recompios-probe)"
  mkdir -p "$work/probe"
  printf 'probe' > "$work/probe/probe.txt"
  copy_to_device "$work/probe" "Documents/.dolbundler-probe" >/dev/null 2>&1 \
    || { rm -rf "$work"; return 1; }

  local layout=''
  if xcrun devicectl device copy from --device "$DEVICE_ID" \
       --domain-type appDataContainer --domain-identifier "$BUNDLE_ID" \
       --source "Documents/.dolbundler-probe/probe.txt" \
       --destination "$work/back" >/dev/null 2>&1; then
    layout=exact
  elif xcrun devicectl device copy from --device "$DEVICE_ID" \
       --domain-type appDataContainer --domain-identifier "$BUNDLE_ID" \
       --source "Documents/.dolbundler-probe/probe/probe.txt" \
       --destination "$work/back" >/dev/null 2>&1; then
    layout=parent
  fi
  rm -rf "$work"

  [ -n "$layout" ] || return 1
  # Overwriting with an empty directory is the only delete devicectl offers.
  local gone; gone="$(mktemp -d -t recompios-empty)"
  copy_to_device "$gone" "Documents/.dolbundler-probe" \
    --remove-existing-content true >/dev/null 2>&1
  rmdir "$gone" 2>/dev/null

  mkdir -p "$DEVICES_DIR/$DEVICE_ID"
  printf '%s\n' "$layout" > "$recorded"
  printf '%s' "$layout"
}

push_game() {
  local disc_id="$1" name="$2" root="$3"
  local stamp="$DEVICES_DIR/$DEVICE_ID/games/$disc_id"

  # The phone caches the title beside the game because it has no ISO to re-read
  # it from. Writing it here rather than into a staged copy is what keeps this
  # a single transfer of the extracted disc -- and it happens before the size
  # is taken, because the file is inside what is being measured.
  printf '%s' "$name" > "$root/dolbundler-title.txt"

  local size; size="$(du -sk "$root" 2>/dev/null | cut -f1)"
  if [ "$FORCE" -eq 0 ] && [ "$(cat "$stamp" 2>/dev/null)" = "$size" ]; then
    ok "$name is already on $DEVICE_NAME"
    info pushed "$disc_id"
    return 0
  fi

  local layout; layout="$(device_copy_layout)" \
    || die "could not reach $DEVICE_NAME's copy of DolBundler. Unlock the phone, keep it plugged in, and make sure the app installed."
  local destination="Documents/games/$disc_id"
  [ "$layout" = parent ] && destination="Documents/games"

  note "$(du -sh "$root" | cut -f1 | tr -d ' ') over the cable; this is the slow half"
  copy_to_device "$root" "$destination" \
    || die "copying $name to $DEVICE_NAME failed. A transfer over Wi-Fi drops often enough that retrying is the first thing to try; over USB it should not."

  mkdir -p "$(dirname "$stamp")"
  printf '%s' "$size" > "$stamp"
  info pushed "$disc_id"
  ok "$name is on $DEVICE_NAME"
}

# --- subcommands --------------------------------------------------------------

if [ "$MODE" = devices ]; then
  device_list
  exit 0
fi

if [ "$MODE" = teams ]; then
  # The phone decides which teams count as ready, so resolve it when one was
  # named and stay quiet when it cannot be found: a team list is still useful
  # with no phone plugged in.
  if [ -n "$ARG_DEVICE" ]; then
    all="$(device_list)"
    IFS=$'\t' read -r _ _ _ _ DEVICE_UDID <<<"$(awk -F'\t' -v want="$(printf '%s' "$ARG_DEVICE" | tr '[:upper:]' '[:lower:]')" '
      tolower($1) == want || index(tolower($2), want) > 0' <<<"$all" | head -1)"
  fi
  team_list
  exit 0
fi

if [ "$MODE" = adopt ]; then
  [ "${#WANTED[@]}" -eq 1 ] || die "adopt takes exactly one --disc-id"
  disc_id="${WANTED[0]}"
  [ -n "$ARG_GENERATED" ] || die "adopt needs --generated <dolrecomp output dir>"
  [ -f "$ARG_GENERATED/generated.h" ] \
    || die "$ARG_GENERATED is not a DolRecomp output directory (no generated.h in it)"
  [ -f "$ARG_GENERATED/main.dol" ] \
    || die "$ARG_GENERATED has no main.dol beside it; module-template validates the module against the DOL it came from, so copy it in first"

  # The triple and CPU are stamped into generated.h by the emitter, so the
  # module says what it was built for rather than being taken on trust.
  adopted_triple="$(sed -n 's/^#define DOLRECOMP_NATIVE_TARGET_TRIPLE "\(.*\)"$/\1/p' \
    "$ARG_GENERATED/generated.h" | head -1)"
  adopted_cpu="$(sed -n 's/^#define DOLRECOMP_NATIVE_TARGET_CPU "\(.*\)"$/\1/p' \
    "$ARG_GENERATED/generated.h" | head -1)"
  [ -n "$adopted_triple" ] \
    || die "$ARG_GENERATED/generated.h names no target triple, so it was not built for a phone"
  case "$adopted_triple" in
    arm64-apple-ios*) ;;
    *) die "that module was built for $adopted_triple, not an iPhone" ;;
  esac

  # Copied rather than referenced. These directories are usually written under
  # /tmp, and a link into one that has been cleared fails at link time with
  # nothing to say which game went missing.
  out="$MODULES_DIR/$disc_id"
  rm -rf "$out"
  mkdir -p "$out"
  cp -R "$ARG_GENERATED" "$out/generated" || { rm -rf "$out"; die "could not copy $ARG_GENERATED"; }
  printf '%s' "$disc_id" > "$out/title"
  printf '%s %s %s\n' "$(shasum -a 256 "$out/generated/main.dol" | cut -d' ' -f1)" \
    "$adopted_triple" "$adopted_cpu" > "$out/dol.sha256"
  info module "$disc_id"
  ok "$disc_id adopted ($adopted_triple, $adopted_cpu); it will be linked into the next iPhone build"
  emit ok
  exit 0
fi

if [ "$MODE" = drop ]; then
  [ "${#WANTED[@]}" -eq 1 ] || die "drop takes exactly one --disc-id"
  disc_id="${WANTED[0]}"
  rm -rf "${MODULES_DIR:?}/$disc_id"
  ok "$disc_id will not be linked into the next iPhone build"

  if [ -n "$ARG_DEVICE" ]; then
    resolve_device
    # There is no delete over devicectl, so the folder is overwritten with an
    # empty one. The phone lists a game by finding sys/main.dol under it, so an
    # empty folder is the same as no game.
    empty="$(mktemp -d -t recompios-empty)"
    if copy_to_device "$empty" "Documents/games/$disc_id" \
         --remove-existing-content true >/dev/null 2>&1; then
      ok "removed $disc_id's disc from $DEVICE_NAME"
    else
      note "could not clear $disc_id off $DEVICE_NAME; delete it in the app or in Files"
    fi
    rmdir "$empty" 2>/dev/null
    rm -f "$DEVICES_DIR/$DEVICE_ID/games/$disc_id"
  else
    rm -f "$DEVICES_DIR"/*/games/"$disc_id"
  fi
  emit ok
  exit 0
fi

# --- profile ------------------------------------------------------------------

if [ "$MODE" = profile ]; then
  [ "${#WANTED[@]}" -ge 1 ] || die "profile needs at least one --disc-id"
  PROFILE=1
  REBUILD=1
  games="$(library_games "${WANTED[@]}")"
  [ -n "$games" ] || die "no such game in the library, or its extracted disc is gone"
  count="$(printf '%s' "$games" | grep -c .)"
  total=$((1 + 2 * count))
  printf '%s%s%s\n' "$bold" "RecompIOS - profiling $count game(s)" "$off"
  step 1 "$total" "Preparing the iPhone recompiler"
  ensure_recompiler
  index=1
  while IFS=$'\t' read -r disc_id name root; do
    [ -n "$disc_id" ] || continue
    recompile_game "$disc_id" "$name" "$root" $((index + 1)) "$total"
    index=$((index + 2))
  done <<<"$games"
  printf '\n%sDone.%s %sThe next send links the new module in.%s\n' "$green" "$off" "$dim" "$off"
  emit ok
  exit 0
fi

# --- send ---------------------------------------------------------------------

command -v xcrun >/dev/null || die "Xcode's command line tools are required"
xcodebuild -version >/dev/null 2>&1 \
  || die "xcodebuild cannot run. Install Xcode, then point the tools at it: sudo xcode-select -s /Applications/Xcode.app"

games="$(library_games "${WANTED[@]+"${WANTED[@]}"}")"
[ -n "$games" ] || die "no game to send. Add a disc image first; a game whose extracted disc has been deleted cannot be sent either."
count="$(printf '%s' "$games" | grep -c .)"
# checks, toolchain, a profile and a recompile and a copy per game, build,
# install
total=$((4 + ($(steps_per_game) + 1) * count))

printf '%s%s%s\n' "$bold" "RecompIOS - $count game(s) to iPhone" "$off"

step 1 "$total" "Checking the iPhone"
resolve_device
ok "$DEVICE_NAME ($DEVICE_MODEL)"
case " $A16_OR_BETTER " in
  *" $DEVICE_PRODUCT "*) ;;
  *) note "warning: games are compiled for $LLVM_CPU and $DEVICE_MODEL is not on the list of phones known to have it. If a game quits the moment it starts, that is the first thing to suspect." ;;
esac
resolve_team

step 2 "$total" "Preparing the iPhone recompiler"
ensure_recompiler

index=2
while IFS=$'\t' read -r disc_id name root; do
  [ -n "$disc_id" ] || continue
  recompile_game "$disc_id" "$name" "$root" $((index + 1)) "$total"
  index=$((index + $(steps_per_game)))
done <<<"$games"

index=$((index + 1))
step "$index" "$total" "Building DolBundler for iPhone"
note "the first build compiles all of Dolphin and takes a while; later ones relink"
build_app || die "the iPhone app did not build (see the log above)"
ok "$(du -sh "$APP_BUNDLE" | cut -f1 | tr -d ' ') signed app"

index=$((index + 1))
step "$index" "$total" "Installing on $DEVICE_NAME"
install_app || die "installing on $DEVICE_NAME failed (see the log above)"
mkdir -p "$DEVICES_DIR/$DEVICE_ID"
date -u +%Y-%m-%dT%H:%M:%SZ > "$DEVICES_DIR/$DEVICE_ID/installed"
printf '%s' "$DEVICE_NAME" > "$DEVICES_DIR/$DEVICE_ID/name"

while IFS=$'\t' read -r disc_id name root; do
  [ -n "$disc_id" ] || continue
  index=$((index + 1))
  step "$index" "$total" "Copying $name to $DEVICE_NAME"
  push_game "$disc_id" "$name" "$root"
done <<<"$games"

if [ "$LAUNCH" -eq 1 ]; then
  xcrun devicectl device process launch --device "$DEVICE_ID" \
    --terminate-existing "$BUNDLE_ID" >/dev/null 2>&1 \
    && note "opened DolBundler on $DEVICE_NAME"
fi

printf '\n%sDone.%s %sOpen DolBundler on %s; the games are in its library.%s\n' \
  "$green" "$off" "$dim" "$DEVICE_NAME" "$off"
printf '%sOn the first install, trust the certificate under Settings > General > VPN & Device Management.%s\n' \
  "$dim" "$off"
emit ok
