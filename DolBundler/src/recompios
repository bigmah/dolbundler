#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# RecompIOS - put library games on an iPhone, native code and all.
#
#   recompios [--porcelain] devices
#   recompios [--porcelain] teams [--device <id>]
#   recompios [--porcelain] send [--device <id>] [--team <id>]
#                                [--disc-id <id>]... [--force] [--no-launch]
#                                [--no-profile] [--profile-seconds <n>]
#   recompios [--porcelain] profile --disc-id <id>... [--profile-seconds <n>]
#   recompios [--porcelain] drop --disc-id <id> [--device <id>]
#   recompios [--porcelain] adopt --disc-id <id> --generated <dir>
#
# `send` is the whole iPhone pipeline, and it is what the window's "Send to
# iPhone" button runs:
#
#   1. profile each game: recompile an instrumented copy for this Mac, play it
#      for a few minutes with scripted input, and keep what was hot
#   2. recompile each game's DOL to arm64 iPhone objects, here on the Mac,
#      laid out and optimised around that profile
#   3. link every recompiled game into DolBundler.app and sign it
#   4. install that app on the phone
#   5. copy each game's extracted disc into the app's Documents folder
#
# Step 3 is why this cannot be one game at a time. Guest code has to be part of
# the signed binary -- iOS will not map a page executable without a valid
# signature behind it -- so adding a game means relinking and reinstalling the
# app with every game in it. Steps 1, 2 and 5 are the slow ones and all are
# skipped when nothing changed, so sending the same library twice is a relink
# and an install rather than an afternoon.
#
# Step 1 exists because the phone has no JIT: every optimisation the game will
# ever get has to be decided here, and the recompiler on its own does not know
# which of a title's ten thousand functions it actually lives in. Profile-guided
# generation (LLVM's instrumented PGO) answers that -- the first title tuned by
# hand this way went from a stutter to full speed on an iPhone 15 Pro Max, and
# every other title in the store was shipping without it. Now every title gets
# it. The profile is gathered on the Mac rather than the phone because the
# instrumented module is the same LLVM IR either way and the Mac runs it in a
# minute what the phone would need a whole install cycle for; the recompiler
# checks the profile against every function it generates and says so if any
# went unmatched. It costs one extra recompile and a few minutes of play per
# game, once per DOL. --no-profile skips it for a quick send; `profile`
# re-collects one for a game that is already in the store, for a longer run
# (--profile-seconds) or after a recompiler change.
#
# A title the developer has taken further has a record in the repository,
# DolBundler/tuning/<ID>/ (written by DolBundler/src/tunegame): the profile
# from a deep dive that found the title's heaviest scene and played it, plus
# the recompiler settings that measured best for it. A send starts from that
# instead of the four-minute generic collection, and says so; the settings
# apply to `profile` too. If the recompiler has since changed enough that the
# committed profile no longer describes what it emits, the send says that and
# falls back to collecting its own.
#
# Games come from the same library.json the window shows, so a disc has to be
# added on the Mac first. With no --disc-id, every game in it that still has
# its extracted disc is sent.
#
# `devices` and `teams` print the pickers' contents, one per line, tab
# separated. `teams` is ordered best-first: a team whose provisioning profile
# covers this app *and* the chosen phone comes before one that only has a
# signing certificate, because the difference is a twenty-minute build that
# fails at the last step.
#
# `drop` removes a game's iPhone module, so the next send links an app without
# it. With --device it also empties that game's folder on the phone.
#
# `adopt` takes a DolRecomp output directory produced by hand -- a PGO build, or
# anything else from ios/README.md's command-line route -- and puts it in the
# store so `send` links it in and leaves it alone. Without this, the first send
# after such a build would quietly produce an app missing that game.
#
# --porcelain adds machine-readable event lines for the GUI and drops the
# colour codes, exactly as in recompgc:
#
#   @@step <index> <total> <title>
#   @@info <key>=<value>        key in: device device_name team
#                                       module=<disc-id> pushed=<disc-id>
#   @@ok
#   @@fail <message>
set -uo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
CONF="$SELF_DIR/toolchain.conf"

MODE=''
case "${1-}" in
  devices|teams|send|profile|drop|adopt) MODE="$1"; shift ;;
  *)
    echo "usage: $(basename "$0") devices|teams|send|profile|drop|adopt [options]" >&2
    exit 2
    ;;
esac

PORCELAIN=0
FORCE=0
LAUNCH=1
# DOLBUNDLER_IOS_PROFILE=0 is the environment's way of saying --no-profile,
# for a window that launches this without a command line to add it to.
PROFILE=1
[ "${DOLBUNDLER_IOS_PROFILE:-1}" = 0 ] && PROFILE=0
# Wall-clock seconds the instrumented game is played for. With the speed
# limiter off a Mac runs a title at several times real time, so the default
# is a handful of guest minutes: past the logos, through the menus, into play.
PROFILE_SECONDS="${DOLBUNDLER_IOS_PROFILE_SECONDS:-240}"
ARG_DEVICE="${DOLBUNDLER_DEVICE:-}"
ARG_TEAM="${DOLBUNDLER_TEAM:-}"
ARG_GENERATED=''
WANTED=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --porcelain)  PORCELAIN=1 ;;
    --device)     ARG_DEVICE="${2-}"; shift ;;
    --team)       ARG_TEAM="${2-}"; shift ;;
    --disc-id)    WANTED+=("${2-}"); shift ;;
    --generated)  ARG_GENERATED="${2-}"; shift ;;
    --force)      FORCE=1 ;;
    --no-launch)  LAUNCH=0 ;;
    --no-profile) PROFILE=0 ;;
    --profile-seconds) PROFILE_SECONDS="${2-}"; shift ;;
    -*)           echo "unknown option: $1" >&2; exit 2 ;;
    *)            echo "unexpected argument: $1" >&2; exit 2 ;;
  esac
  shift
done
case "$PROFILE_SECONDS" in
  ''|*[!0-9]*) echo "--profile-seconds takes a whole number of seconds" >&2; exit 2 ;;
esac

if [ "$PORCELAIN" -eq 1 ]; then
  bold=''; dim=''; red=''; green=''; off=''
else
  bold=$'\033[1m'; dim=$'\033[2m'; red=$'\033[31m'; green=$'\033[32m'; off=$'\033[0m'
fi

emit()  { [ "$PORCELAIN" -eq 1 ] && printf '@@%s\n' "$*"; return 0; }
step()  { emit "step $1 $2 $3"
          [ "$PORCELAIN" -eq 1 ] && return 0
          printf '\n%s==> %s/%s  %s%s\n' "$bold" "$1" "$2" "$3" "$off"; }
info()  { emit "info $1=$2"; }
note()  { printf '%s    %s%s\n' "$dim" "$*" "$off"; }
ok()    { printf '%s    %s%s\n' "$green" "$*" "$off"; }
die()   { emit "fail $*"; printf '\n%serror: %s%s\n' "$red" "$*" "$off" >&2; exit 1; }

# ios/build.sh writes its headings with the same escape codes this script
# suppresses in porcelain mode, and the window renders raw text.
strip_colour() { sed $'s/\033\\[[0-9;]*m//g'; }

[ -f "$CONF" ] || die "missing $CONF; re-run DolBundler/build.sh"
# shellcheck source=/dev/null
source "$CONF"

# A window launched from Finder inherits launchd's PATH - /usr/bin:/bin and the
# two sbins - so Homebrew's cmake and ninja are invisible exactly when the app
# is how you started this, and only then. build.sh records where it found them.
[ -n "${TOOLCHAIN_PATH-}" ] && export PATH="$TOOLCHAIN_PATH:$PATH"
: "${MG_SRC:?toolchain.conf did not set MG_SRC}"
# The desktop runtime that plays a game for its profile lives in the ModernGekko
# build; a conf from before that was recorded still has the source tree.
: "${MG_BUILD:=$MG_SRC/build}"
# REPO_ROOT was added to toolchain.conf after this script; a conf written by an
# older build.sh still has MG_SRC, which sits one level down from the root.
REPO_ROOT="${REPO_ROOT:-$(dirname "$MG_SRC")}"

BUNDLE_ID="${DOLBUNDLER_BUNDLE_ID:-com.bigmah.dolbundler}"
SUPPORT_DIR="$HOME/Library/Application Support/DolBundler"
LIBRARY="$SUPPORT_DIR/library.json"
IOS_DIR="$SUPPORT_DIR/iphone"
MODULES_DIR="$IOS_DIR/modules"
DEVICES_DIR="$IOS_DIR/devices"
LLVM_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/Library/Caches}/DolBundler/iphone-llvm"
# The per-title records the repository carries; see DolBundler/tuning/README.md.
TUNING_ROOT="$REPO_ROOT/DolBundler/tuning"

# The deployment target, the triple and the CPU have to agree with what the app
# itself is built with: ios/build.sh passes 17.0, and ModernGekko compiles
# GXRuntime's guest CPU helpers with -mcpu=apple-a16 so a lane computed in a
# helper matches one the generated code inlined. Changing either here alone
# produces a module that links and then behaves differently from the runtime
# it calls into.
LLVM_TARGET="${DOLRECOMP_LLVM_TARGET:-arm64-apple-ios17.0}"
LLVM_CPU="${DOLRECOMP_LLVM_CPU:-apple-a16}"

# The instrumented copy a profile is gathered from is built for this Mac. Same
# CPU as the phone build: the profile is keyed on the LLVM IR the recompiler
# emits, which does not depend on the target, but there is no reason to let the
# two differ in anything. The pinned LLVM 20's own llvm-profdata merges the
# counters, since it is the same LLVM that reads them back; Xcode's is the
# fallback when the wrapper was built against another root.
MAC_LLVM_TARGET="${DOLRECOMP_LLVM_MAC_TARGET:-arm64-apple-macos14.0}"
LLVM_PROFDATA="${DOLRECOMP_LLVM20_ROOT:-/opt/homebrew/opt/llvm@20}/bin/llvm-profdata"
[ -x "$LLVM_PROFDATA" ] || LLVM_PROFDATA="xcrun llvm-profdata"
# A Gekko runs at 486 MHz; the chassis charges guest cycles, so this turns a
# run's cycle count back into the guest time it covered.
GEKKO_HZ=486000000

# One object per guest-code chunk, and a GameCube game has thousands of them.
# dolrecomp emits them one at a time unless it is told otherwise -- the default
# is -j1, not a core count -- and each is an independent LLVM invocation, so
# this is the difference between minutes and the better part of an hour. The
# workers are short-lived fork children of a process holding the whole DolIR,
# which is copy-on-write and read-only in the child, so the cost is CPU rather
# than another copy of the game per core.
JOBS="${DOLBUNDLER_IOS_JOBS:-$(sysctl -n hw.ncpu 2>/dev/null || echo 4)}"

# Phones whose chip is at least an A16, which is what LLVM_CPU names. Anything
# else gets a warning rather than a refusal: the list is a list, not a
# capability query, and a wrong entry should not stop someone building.
A16_OR_BETTER='iPhone15,2 iPhone15,3 iPhone15,4 iPhone15,5 iPhone16,1 iPhone16,2 iPhone17,1 iPhone17,2 iPhone17,3 iPhone17,4 iPhone17,5 iPhone18,1 iPhone18,2 iPhone18,3 iPhone18,4'

# --- devices -----------------------------------------------------------------

# identifier \t name \t marketing name \t product type \t udid
device_list() {
  local json; json="$(mktemp -t recompios-devices)"
  xcrun devicectl list devices --json-output "$json" >/dev/null 2>&1
  /usr/bin/python3 - "$json" <<'PY'
import json, sys
try:
    devices = json.load(open(sys.argv[1]))["result"]["devices"]
except Exception:
    devices = []
for d in devices:
    hardware = d.get("hardwareProperties", {})
    properties = d.get("deviceProperties", {})
    print("\t".join([
        d.get("identifier", ""),
        properties.get("name", ""),
        hardware.get("marketingName", ""),
        hardware.get("productType", ""),
        hardware.get("udid", ""),
    ]))
PY
  rm -f "$json"
}

DEVICE_ID=''; DEVICE_NAME=''; DEVICE_MODEL=''; DEVICE_PRODUCT=''; DEVICE_UDID=''

# Never guesses between phones. The wrong guess is a locked phone on a desk
# while the one in your hand gets nothing.
resolve_device() {
  local all matched count
  all="$(device_list)"
  [ -n "$all" ] || die "no paired iPhone. Plug it in, unlock it, and tap Trust."

  if [ -n "$ARG_DEVICE" ]; then
    matched="$(awk -F'\t' -v want="$(printf '%s' "$ARG_DEVICE" | tr '[:upper:]' '[:lower:]')" '
      tolower($1) == want || index(tolower($2), want) > 0' <<<"$all")"
  else
    matched="$all"
  fi

  count="$(printf '%s' "$matched" | grep -c . || true)"
  if [ "$count" -ne 1 ]; then
    {
      if [ -n "$ARG_DEVICE" ] && [ "$count" -eq 0 ]; then
        printf 'no paired device matches %s. Paired now:\n' "$ARG_DEVICE"
        matched="$all"
      elif [ -n "$ARG_DEVICE" ]; then
        printf '%s matches more than one paired device:\n' "$ARG_DEVICE"
      else
        printf 'more than one iPhone is paired; choose one in Settings:\n'
      fi
      awk -F'\t' '{ printf "  %s  %s (%s)\n", $1, $2, $3 }' <<<"$matched"
    } >&2
    die "pick which iPhone to send to"
  fi

  IFS=$'\t' read -r DEVICE_ID DEVICE_NAME DEVICE_MODEL DEVICE_PRODUCT DEVICE_UDID \
    <<<"$matched"
  info device "$DEVICE_ID"
  info device_name "$DEVICE_NAME"
}

# --- signing teams -----------------------------------------------------------

# team id \t label, best first. A team that can actually reach this phone comes
# ahead of one that merely has a certificate, because the difference only shows
# up after the build.
team_list() {
  /usr/bin/python3 - "$BUNDLE_ID" "${DEVICE_UDID:-}" <<'PY'
import glob, os, plistlib, re, subprocess, sys

bundle_id, udid = sys.argv[1], sys.argv[2]
teams = {}

def record(team, name, rank, label):
    known = teams.get(team)
    if known is None or rank < known[0]:
        teams[team] = (rank, name, label)

profiles = os.path.expanduser(
    "~/Library/Developer/Xcode/UserData/Provisioning Profiles/*.mobileprovision")
for path in glob.glob(profiles):
    try:
        raw = open(path, "rb").read()
        start, end = raw.find(b"<?xml"), raw.find(b"</plist>")
        profile = plistlib.loads(raw[start:end + len(b"</plist>")])
    except Exception:
        continue
    identifiers = profile.get("TeamIdentifier") or []
    if not identifiers:
        continue
    team = identifiers[0]
    name = profile.get("TeamName") or team
    app_id = (profile.get("Entitlements") or {}).get("application-identifier", "")
    if app_id not in (f"{team}.{bundle_id}", f"{team}.*"):
        continue
    expires = profile.get("ExpirationDate")
    expiry = f", expires {expires:%-d %b %Y}" if expires else ""
    devices = profile.get("ProvisionedDevices") or []
    if udid and udid in devices:
        record(team, name, 0, f"{name} - ready for this iPhone{expiry}")
    elif udid:
        record(team, name, 1,
               f"{name} - its profile does not list this iPhone{expiry}")
    else:
        record(team, name, 1, f"{name} - has a profile for this app{expiry}")

# A team with a signing certificate but no profile is still worth offering:
# Xcode can make the profile itself, given an account to make it with.
try:
    listing = subprocess.run(["security", "find-identity", "-v", "-p", "codesigning"],
                             capture_output=True, text=True).stdout
except Exception:
    listing = ""
for line in listing.splitlines():
    common_name = re.search(r'"([^"]+)"', line)
    if not common_name:
        continue
    try:
        pem = subprocess.run(["security", "find-certificate", "-c", common_name.group(1), "-p"],
                             capture_output=True, text=True).stdout
        subject = subprocess.run(["openssl", "x509", "-noout", "-subject"],
                                 input=pem, capture_output=True, text=True).stdout
    except Exception:
        continue
    unit = re.search(r"OU\s*=\s*([A-Z0-9]+)", subject)
    org = re.search(r"O\s*=\s*([^,/]+)", subject)
    if not unit:
        continue
    name = (org.group(1).strip() if org else unit.group(1))
    record(unit.group(1), name, 2,
           f"{name} - signing certificate only, no profile for this app yet")

for team, (_, _, label) in sorted(teams.items(), key=lambda kv: (kv[1][0], kv[1][1])):
    print(f"{team}\t{label}")
PY
}

TEAM=''; TEAM_LABEL=''

resolve_team() {
  local teams; teams="$(team_list)"

  if [ -n "$ARG_TEAM" ]; then
    TEAM="$ARG_TEAM"
    TEAM_LABEL="$(awk -F'\t' -v team="$TEAM" '$1 == team { print $2 }' <<<"$teams")"
    [ -n "$TEAM_LABEL" ] || TEAM_LABEL="no signing certificate for this team in the keychain"
  else
    IFS=$'\t' read -r TEAM TEAM_LABEL <<<"$(head -1 <<<"$teams")"
  fi

  [ -n "$TEAM" ] || die "no Apple Developer team to sign with. Open Xcode, add your Apple ID under Settings > Accounts, then choose the team in DolBundler's Settings."
  info team "$TEAM"
  note "signing as $TEAM ($TEAM_LABEL)"
  case "$TEAM_LABEL" in
    *"ready for this iPhone"*) ;;
    *) note "if the install is refused at the end, this is why: Xcode has to add $DEVICE_NAME to the team's profile, which needs an Apple ID in Xcode > Settings > Accounts" ;;
  esac
}

# --- the library -------------------------------------------------------------

# disc id \t name \t game root, for the games asked for, or all of them.
library_games() {
  /usr/bin/python3 - "$LIBRARY" "$@" <<'PY'
import json, os, sys

path, wanted = sys.argv[1], sys.argv[2:]
try:
    games = json.load(open(path)).get("games", [])
except Exception:
    games = []
by_id = {game.get("disc_id", ""): game for game in games if game.get("disc_id")}
for disc_id in (wanted or sorted(by_id)):
    game = by_id.get(disc_id)
    if game is None:
        continue
    root = game.get("game_root", "")
    if not os.path.isfile(os.path.join(root, "sys", "main.dol")):
        continue
    print("\t".join([disc_id, game.get("name") or disc_id, root]))
PY
}

# --- recompiling for the phone -----------------------------------------------

DOLRECOMP_IOS="$REPO_ROOT/build-dolrecomp-llvm20/dolrecomp"

ensure_recompiler() {
  if [ -x "$DOLRECOMP_IOS" ] && [ "$FORCE" -eq 0 ]; then
    note "$DOLRECOMP_IOS"
    return 0
  fi
  [ -x "$REPO_ROOT/ios/build-dolrecomp-llvm20.sh" ] \
    || die "missing $REPO_ROOT/ios/build-dolrecomp-llvm20.sh; the checkout DolBundler was built from has moved or is incomplete"
  note "building the pinned LLVM 20 recompiler; the first one takes a few minutes"
  "$REPO_ROOT/ios/build-dolrecomp-llvm20.sh" 2>&1 | strip_colour
  [ "${PIPESTATUS[0]}" -eq 0 ] || die "could not build the iPhone recompiler (see the log above)"
  [ -x "$DOLRECOMP_IOS" ] || die "the recompiler build did not produce $DOLRECOMP_IOS"
}

# What a built module was built from. A module is reused only when the DOL, the
# triple and the CPU all still match; anything else and the objects would be
# linked against a runtime that no longer agrees with them. A title with a
# tuning record carries the record's identity too, so a re-tuned title is
# rebuilt on its next send rather than left on the older profile.
module_stamp() {  # <dol> [disc id]
  local tuning=''
  if [ -n "${2-}" ] && [ -f "$TUNING_ROOT/$2/tuning.conf" ]; then
    tuning=" tuning=$(cat "$TUNING_ROOT/$2/tuning.conf" "$TUNING_ROOT/$2"/profile.profdata.xz 2>/dev/null \
      | shasum -a 256 | cut -c1-16)"
  fi
  printf '%s %s %s%s\n' "$(shasum -a 256 "$1" | cut -d' ' -f1)" "$LLVM_TARGET" "$LLVM_CPU" "$tuning"
}

# --- the tuning record --------------------------------------------------------

# Read with a whitelist rather than sourced: the file is data, and the only
# keys that change a build are the two below. Everything else in it is what the
# dive measured, for people. Sets the TUNING_* globals; false when there is no
# record for the title.
TUNING_CHUNK=''; TUNING_PROFILE=''; TUNING_ON=''; TUNING_SPEED=''
# Past this share of chunks the emitter no longer produces what the profile
# describes, and a fresh generic profile is the better module.
TUNING_STALE_MAX=10
read_tuning_record() {  # <disc id>
  local dir="$TUNING_ROOT/$1" key value
  TUNING_CHUNK=''; TUNING_PROFILE=''; TUNING_ON=''; TUNING_SPEED=''
  [ -f "$dir/tuning.conf" ] || return 1
  while IFS='=' read -r key value; do
    case "$key" in
      LLVM_CHUNK_INSTRUCTIONS) TUNING_CHUNK="$value" ;;
      PROFILE)                 TUNING_PROFILE="$dir/$value" ;;
      TUNED_ON)                TUNING_ON="$value" ;;
      SPEED_TUNED)             TUNING_SPEED="$value" ;;
    esac
  done < <(grep -E '^[A-Z_]+=' "$dir/tuning.conf")
  case "$TUNING_CHUNK" in ''|*[!0-9]*) TUNING_CHUNK='' ;; esac
  [ -n "$TUNING_PROFILE" ] && [ ! -f "$TUNING_PROFILE" ] && TUNING_PROFILE=''
  return 0
}

# The committed profile is xz-compressed -- a few hundred kilobytes against
# tens of megabytes raw. Python's lzma is on every Mac; xz is not.
expand_tuning_profile() {  # <.xz> <out>
  /usr/bin/python3 - "$1" "$2" <<'PYLZMA'
import lzma, shutil, sys
with lzma.open(sys.argv[1], "rb") as src, open(sys.argv[2], "wb") as dst:
    shutil.copyfileobj(src, dst)
PYLZMA
}

# Whether a module was generated against a profile. Read from the module's own
# generated.h rather than from a stamp of ours: the emitter folds the profile's
# content hash into the codegen fingerprint it writes there, so a hand-built
# PGO module brought in with `adopt` counts, and a module that merely sat
# beside a profile does not.
module_is_profiled() {
  grep -q 'pgo=use:' "$1/generated/generated.h" 2>/dev/null
}

# --- profiling a game on this Mac --------------------------------------------

# The controller the profiling run plays with. Dolphin offers every FIFO in
# <user-dir>/Pipes as an input device, fed by lines of text, and this is the
# same device the desktop app uses for its NSO controller driver -- the one
# input path that does not need a keyboard, a window or a human.
write_pipe_pad_config() {  # <user dir>
  mkdir -p "$1/Config" "$1/Pipes"
  rm -f "$1/Pipes/pad1"
  mkfifo "$1/Pipes/pad1" || return 1
  cat > "$1/Config/GCPadNew.ini" <<'INI'
[GCPad1]
Device = Pipe/0/pad1
Buttons/A = `Button A`
Buttons/B = `Button B`
Buttons/X = `Button X`
Buttons/Y = `Button Y`
Buttons/Z = `Button Z`
Buttons/Start = `Button START`
Main Stick/Up = `Axis MAIN Y +`
Main Stick/Down = `Axis MAIN Y -`
Main Stick/Left = `Axis MAIN X -`
Main Stick/Right = `Axis MAIN X +`
Main Stick/Calibration = 100.00
C-Stick/Up = `Axis C Y +`
C-Stick/Down = `Axis C Y -`
C-Stick/Left = `Axis C X -`
C-Stick/Right = `Axis C X +`
C-Stick/Calibration = 100.00
Triggers/L = `Button L`
Triggers/R = `Button R`
Triggers/L-Analog = `Axis L +`
Triggers/R-Analog = `Axis R +`
D-Pad/Up = `Button D_UP`
D-Pad/Down = `Button D_DOWN`
D-Pad/Left = `Button D_LEFT`
D-Pad/Right = `Button D_RIGHT`
